{% stylesheet %}
  .invite-block {
    padding: 9rem 2rem;
  }

  .invite-block__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .invite-tag {
    display: inline-block;
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.4rem 1.2rem;
    margin-bottom: 2.4rem;
    background-color: var(--invite-accent, rgb(var(--color-button)));
    color: rgb(var(--color-button-label));
  }

  .invite-block__title {
    font-family: var(--font-heading-family);
    font-size: clamp(3rem, 4.5vw, 5.2rem);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 2.4rem;
    max-width: 640px;
    color: rgb(var(--color-foreground));
  }

  .invite-block__lead {
    font-size: 1.7rem;
    line-height: 1.85;
    max-width: 620px;
    margin-bottom: 4rem;
    opacity: 0.8;
    color: rgb(var(--color-foreground));
  }

  .invite-perks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    margin-bottom: 5rem;
  }

  @media screen and (min-width: 750px) {
    .invite-perks { grid-template-columns: repeat(3, 1fr); }
  }

  .invite-perk {
    background: rgba(var(--color-foreground), 0.04);
    border: 1px solid rgba(var(--color-foreground), 0.1);
    padding: 3rem 2.4rem;
  }

  .invite-perk__icon {
    font-size: 2rem;
    margin-bottom: 1.2rem;
    display: block;
    color: var(--invite-accent, rgb(var(--color-button)));
  }

  .invite-perk__title {
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 400;
    margin-bottom: 0.8rem;
    color: rgb(var(--color-foreground));
  }

  .invite-perk__text {
    font-size: 1.3rem;
    line-height: 1.7;
    opacity: 0.7;
    color: rgb(var(--color-foreground));
  }

  .invite-cta {
    display: inline-block;
    padding: 1.4rem 3.6rem;
    font-size: 1.2rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    margin-right: 1.6rem;
    margin-bottom: 1.6rem;
    border: 1px solid rgb(var(--color-button));
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-label));
    transition: background 0.2s, color 0.2s;
  }

  .invite-cta:hover {
    background: transparent;
    color: rgb(var(--color-button));
  }

  .invite-cta--ghost {
    background: transparent;
    color: rgb(var(--color-secondary-button-label));
    border-color: rgba(var(--color-foreground), 0.3);
  }

  .invite-cta--ghost:hover {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-label));
    border-color: rgb(var(--color-button));
  }
{% endstylesheet %}

<div class="invite-block color-{{ section.settings.color_scheme }} gradient" style="--invite-accent: {{ section.settings.accent_color }};">
  <div class="invite-block__inner">

    <span class="invite-tag">{{ section.settings.tag | escape }}</span>
    <h2 class="invite-block__title">{{ section.settings.title | escape }}</h2>
    <p class="invite-block__lead">{{ section.settings.lead | escape }}</p>

    {%- if section.blocks.size > 0 -%}
      <div class="invite-perks">
        {%- for block in section.blocks -%}
          {%- if block.type == 'perk' -%}
            <div class="invite-perk" {{ block.shopify_attributes }}>
              <span class="invite-perk__icon">{{ block.settings.icon | escape }}</span>
              <h3 class="invite-perk__title">{{ block.settings.title | escape }}</h3>
              <p class="invite-perk__text">{{ block.settings.text | escape }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <a href="{{ section.settings.cta_link }}" class="invite-cta">{{ section.settings.cta_label | escape }}</a>
    <a href="mailto:{{ section.settings.email | escape }}" class="invite-cta invite-cta--ghost">{{ section.settings.email_label | escape }}</a>

  </div>
</div>

{% schema %}
{
  "name": "Invite — Partner",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#7f6464"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Section tag",
      "default": "Herprint Partner"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "For the ambitious women ready to build something real."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead text",
      "default": "We are looking for driven, passionate women around the world to grow with us. Herprint is not just a jewelry brand — it is a movement."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button",
      "default": "Become a Partner"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "default": "partner@herprint.co"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email button label",
      "default": "Tell us your story"
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "presets": [{
    "name": "Invite — Partner",
    "blocks": [
      { "type": "perk", "settings": { "icon": "✦", "title": "Build with Us", "text": "Join our core team as a regional partner, brand ambassador or creative collaborator." } },
      { "type": "perk", "settings": { "icon": "◇", "title": "Grow Together", "text": "Access resources, mentorship and a global network of women who lift each other up." } },
      { "type": "perk", "settings": { "icon": "○", "title": "Make an Impact", "text": "A portion of every sale goes into our fund — supporting children and single mothers worldwide." } }
    ]
  }]
}
{% endschema %}

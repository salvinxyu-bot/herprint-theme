<style>
@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@600;700;800&family=JetBrains+Mono:wght@500;700&display=swap');

.mimi-root {
  --good:#8caa6d; --good-deep:#6f8c52; --good-bg:#e9f0dd;
  --bad:#d98a8e; --bad-deep:#c46b70; --bad-bg:#f7e6e6;
  --lav:#b6a9d4; --lav-deep:#8f7fb8;
  --ink:#5d556a; --muted:#9b93a8; --line:#ddd5e6; --code:#4b4658;

  font-family:'Nunito',system-ui,sans-serif;
  color:var(--ink);
  min-height:100vh;
  display:flex;
  justify-content:center;
  padding:16px 16px 48px;
  overflow-x:hidden;
  position:relative;
  background:
    radial-gradient(90% 60% at 12% 8%, rgba(182,169,212,.55), transparent 60%),
    radial-gradient(80% 55% at 88% 14%, rgba(169,197,224,.5), transparent 60%),
    radial-gradient(90% 60% at 80% 92%, rgba(239,193,200,.45), transparent 60%),
    radial-gradient(90% 70% at 18% 88%, rgba(169,194,160,.5), transparent 60%),
    linear-gradient(180deg,#eef0e9,#f4ece9);
}
.mimi-root *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
.mimi-root .stage{width:100%;max-width:480px;display:flex;flex-direction:column;position:relative;z-index:1;perspective:1600px}
.mimi-root .deco{position:absolute;pointer-events:none;opacity:.5;z-index:0}
.mimi-root .d1{top:7%;left:6%;font-size:26px;animation:mimi-drift 7s ease-in-out infinite}
.mimi-root .d2{top:13%;right:7%;font-size:22px;animation:mimi-drift 8s ease-in-out infinite .6s}
.mimi-root .d3{bottom:11%;left:9%;font-size:24px;animation:mimi-drift 9s ease-in-out infinite 1.1s}
.mimi-root .d4{bottom:18%;right:8%;font-size:22px;animation:mimi-drift 7.5s ease-in-out infinite .9s}
@keyframes mimi-drift{0%,100%{transform:translateY(0) rotate(-5deg)}50%{transform:translateY(-13px) rotate(5deg)}}

.mimi-root .brand{position:absolute;left:50%;bottom:9px;transform:translateX(-50%);z-index:6;pointer-events:none;
  font-family:'Baloo 2';font-weight:700;font-size:12px;letter-spacing:1.5px;color:var(--lav-deep);
  background:rgba(255,255,255,.6);padding:4px 14px;border-radius:20px;white-space:nowrap;
  box-shadow:0 1px 4px rgba(143,127,184,.12)}

.mimi-root .top{display:flex;align-items:center;gap:10px;margin-bottom:8px;visibility:hidden}
.mimi-root .back{background:rgba(255,255,255,.8);border:2px solid var(--line);border-radius:12px;width:38px;height:34px;
  font-size:16px;cursor:pointer;flex-shrink:0;color:var(--lav-deep)}
.mimi-root .bar{flex:1;height:15px;background:rgba(255,255,255,.7);border:2px solid var(--line);border-radius:20px;overflow:hidden}
.mimi-root .fill{height:100%;width:0;background:linear-gradient(90deg,#a9c2a0,#8fb8b2);border-radius:20px;transition:width .45s cubic-bezier(.2,.8,.2,1)}
.mimi-root .hearts{display:flex;gap:1px;font-size:15px}
.mimi-root .hearts .h{transition:transform .3s,opacity .3s}
.mimi-root .hearts .h.gone{opacity:.2;transform:scale(.8)}
.mimi-root .lvtag{text-align:center;font-family:'Baloo 2';font-weight:700;font-size:12px;color:var(--lav-deep);letter-spacing:.8px;margin-bottom:16px;visibility:hidden}

.mimi-root .screen{display:none;position:relative}
.mimi-root .screen.on{display:block;animation:mimi-pop .4s cubic-bezier(.2,.9,.3,1.15)}
@keyframes mimi-pop{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:none}}

.mimi-root .screen.flip-out{display:block;position:absolute;top:0;left:0;width:100%;z-index:12;
  transform-origin:left center;backface-visibility:hidden;animation:mimi-pageTurnOut .62s cubic-bezier(.4,.05,.5,.95) forwards}
@keyframes mimi-pageTurnOut{
  0%{transform:rotateY(0);box-shadow:0 0 0 rgba(93,85,106,0)}
  100%{transform:rotateY(-112deg);box-shadow:26px 0 46px rgba(93,85,106,.22)}}
.mimi-root .screen.flip-in{animation:mimi-pageTurnIn .62s ease-out}
@keyframes mimi-pageTurnIn{0%{opacity:.35;transform:scale(.985)}100%{opacity:1;transform:none}}

.mimi-root .screen.fade-out{display:block;position:absolute;top:0;left:0;width:100%;z-index:12;animation:mimi-fadeOut .4s ease forwards}
@keyframes mimi-fadeOut{from{opacity:1;transform:scale(1)}to{opacity:0;transform:scale(1.04)}}
.mimi-root .screen.fade-in{animation:mimi-fadeIn .5s ease .12s both}
@keyframes mimi-fadeIn{from{opacity:0}to{opacity:1}}

.mimi-root .cover{display:flex;flex-direction:column;justify-content:center;min-height:84vh}
.mimi-root .cover-frame{background:rgba(255,255,255,.5);border:2px solid var(--line);border-radius:28px;
  padding:30px 22px 30px;box-shadow:0 8px 0 rgba(143,127,184,.16);text-align:center;position:relative;overflow:hidden}
.mimi-root .cover-frame:before{content:'';position:absolute;inset:6px;border:1.5px solid rgba(182,169,212,.35);border-radius:22px;pointer-events:none}
.mimi-root .ribbon{display:inline-block;font-family:'Baloo 2';font-weight:800;font-size:11px;letter-spacing:2px;
  color:#fff;background:var(--lav-deep);padding:5px 14px;border-radius:30px;margin-bottom:6px}
.mimi-root .eyebrow{font-family:'Baloo 2';font-weight:700;font-size:13px;letter-spacing:3px;color:var(--lav-deep);text-transform:uppercase;margin-top:8px}
.mimi-root .cover h1{font-family:'Baloo 2';font-weight:800;font-size:46px;line-height:1;margin:2px 0 4px}
.mimi-root .cover h1 .pop{color:var(--lav-deep)}
.mimi-root .cover .tag{color:var(--muted);font-weight:700;font-size:15px;margin-bottom:4px}
.mimi-root .cover .meta{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin:16px 0 22px}
.mimi-root .cover .meta .m{background:rgba(255,255,255,.85);border:2px solid var(--line);border-radius:30px;
  padding:6px 13px;font-weight:800;font-size:12.5px;color:var(--lav-deep)}
.mimi-root .cover .mascot.big{width:178px}

.mimi-root .mascot{width:124px;flex-shrink:0}
.mimi-root .mascot.big{width:200px;margin:0 auto;display:block}
.mimi-root .mascot svg{display:block;width:100%}
.mimi-root .bob{animation:mimi-bob 3.6s ease-in-out infinite}
@keyframes mimi-bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.mimi-root .tail{transform-box:fill-box;transform-origin:18% 82%;animation:mimi-wag .65s ease-in-out infinite}
@keyframes mimi-wag{0%,100%{transform:rotate(-14deg)}50%{transform:rotate(16deg)}}
.mimi-root .eyes{transform-box:fill-box;transform-origin:center;animation:mimi-blink 4.2s infinite}
@keyframes mimi-blink{0%,93%,100%{transform:scaleY(1)}96.5%{transform:scaleY(.08)}}
.mimi-root .cheer{animation:mimi-cheer .6s ease}
@keyframes mimi-cheer{0%,100%{transform:translateY(0) rotate(0)}25%{transform:translateY(-14px) rotate(-6deg)}75%{transform:translateY(-14px) rotate(6deg)}}
.mimi-root .shake{animation:mimi-shake .5s ease}
@keyframes mimi-shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-7px)}75%{transform:translateX(7px)}}

.mimi-root .hi{text-align:center;margin-bottom:6px}
.mimi-root .hi h1{font-family:'Baloo 2';font-weight:800;font-size:34px;line-height:1.05}
.mimi-root .hi h1 .pop{color:var(--lav-deep)}
.mimi-root .hi p{color:var(--muted);font-weight:700;font-size:14px;margin-top:2px}
.mimi-root .map{display:flex;flex-direction:column;gap:11px;margin-top:14px}
.mimi-root .setcard{display:flex;align-items:center;gap:13px;background:rgba(255,255,255,.92);border:2px solid var(--line);
  border-bottom-width:5px;border-radius:18px;padding:13px 15px;cursor:pointer;transition:transform .08s,border-color .15s}
.mimi-root .setcard:hover{border-color:var(--lav)}
.mimi-root .setcard:active{transform:translateY(2px);border-bottom-width:3px}
.mimi-root .num{width:46px;height:46px;border-radius:14px;flex-shrink:0;display:flex;align-items:center;justify-content:center;
  font-family:'Baloo 2';font-weight:800;font-size:20px;color:#fff}
.mimi-root .setinfo{flex:1;min-width:0}
.mimi-root .setinfo .tier{font-family:'Baloo 2';font-weight:700;font-size:11px;letter-spacing:.6px;text-transform:uppercase;color:var(--muted)}
.mimi-root .setinfo .nm{font-family:'Baloo 2';font-weight:700;font-size:16px;line-height:1.15}
.mimi-root .chev{font-size:18px;color:var(--muted);flex-shrink:0}
.mimi-root .chev.done{color:var(--good)}

.mimi-root .prog{background:linear-gradient(135deg,#b6a9d4,#8fb8b2);color:#fff;border-radius:20px;padding:16px 18px 14px;
  margin:14px 0 4px;box-shadow:0 5px 0 rgba(143,127,184,.3)}
.mimi-root .prog-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:11px}
.mimi-root .prog-big{font-family:'Baloo 2';font-weight:800;font-size:34px;line-height:1}
.mimi-root .prog-big span{font-size:18px;opacity:.85}
.mimi-root .prog-sub{font-weight:800;font-size:11px;text-transform:uppercase;letter-spacing:.6px;opacity:.92;margin-top:2px}
.mimi-root .prog-stats{text-align:right;font-family:'Baloo 2';font-weight:700;font-size:15px;line-height:1.55}
.mimi-root .prog-bar{height:14px;background:rgba(255,255,255,.35);border-radius:20px;overflow:hidden}
.mimi-root .prog-fill{height:100%;background:#fff;border-radius:20px;transition:width .55s cubic-bezier(.2,.8,.2,1)}
.mimi-root .prog-reset{display:block;margin:9px auto 0;background:none;border:none;color:rgba(255,255,255,.8);
  font-weight:800;font-size:11px;letter-spacing:.4px;text-decoration:underline;cursor:pointer}
.mimi-root .cright{text-align:right;flex-shrink:0;min-width:30px}
.mimi-root .cstars{font-size:13px;line-height:1}
.mimi-root .cbest{font-size:10px;font-weight:800;color:var(--muted);margin-top:3px}
.mimi-root .cgo{font-size:18px;color:var(--muted)}
.mimi-root .setcard.locked{opacity:.5;cursor:not-allowed}
.mimi-root .setcard.locked:hover{border-color:var(--line)}
.mimi-root .setcard.deny{animation:mimi-shake .4s ease}
.mimi-root .lock{font-size:17px}
.mimi-root .badge-perfect{margin-top:11px;background:linear-gradient(135deg,#f3e2a6,#e6b85f);color:#6b531a;
  font-family:'Baloo 2';font-weight:800;font-size:13px;text-align:center;padding:9px;border-radius:13px;
  letter-spacing:.4px;box-shadow:0 2px 0 rgba(180,140,60,.3)}

.mimi-root .talk{display:flex;align-items:flex-end;gap:10px;margin-bottom:16px}
.mimi-root .bubble{background:rgba(255,255,255,.92);border:2px solid var(--line);border-radius:18px;padding:12px 15px;
  font-weight:700;font-size:15px;line-height:1.4;position:relative;flex:1;box-shadow:0 3px 0 rgba(143,127,184,.13)}
.mimi-root .bubble:after{content:'';position:absolute;left:-9px;bottom:15px;width:14px;height:14px;background:rgba(255,255,255,.92);
  border-left:2px solid var(--line);border-bottom:2px solid var(--line);transform:rotate(45deg)}

.mimi-root .kind{display:inline-flex;align-items:center;gap:6px;background:var(--lav);color:#fff;font-family:'Baloo 2';
  font-weight:700;font-size:13px;padding:5px 13px;border-radius:30px;margin-bottom:14px}
.mimi-root pre.code{font-family:'JetBrains Mono',monospace;font-size:14.5px;line-height:1.7;background:var(--code);color:#f1ece4;
  border-radius:16px;padding:16px 18px;margin-bottom:18px;overflow-x:auto;white-space:pre;box-shadow:0 4px 0 rgba(75,70,88,.25)}
.mimi-root pre.code .blank{color:#f3e2a6;background:rgba(243,226,166,.18);padding:0 7px;border-radius:5px}
.mimi-root pre.code .lit{color:#bcd6a8}
.mimi-root pre.code .fn{color:#c3b6e0}
.mimi-root pre.code .kw{color:#e8b4be}

.mimi-root .opts{display:flex;flex-direction:column;gap:11px}
.mimi-root .opt{display:flex;align-items:center;gap:12px;text-align:left;background:rgba(255,255,255,.92);border:2px solid var(--line);
  border-bottom-width:5px;border-radius:16px;padding:14px 16px;font-family:'JetBrains Mono',monospace;font-size:15.5px;
  font-weight:500;color:var(--ink);cursor:pointer;transition:transform .07s,border-color .15s,background .15s}
.mimi-root .opt:hover:not(:disabled){background:#fff;border-color:var(--lav)}
.mimi-root .opt:active:not(:disabled){transform:translateY(2px);border-bottom-width:3px}
.mimi-root .opt:disabled{cursor:default}
.mimi-root .opt .k{width:26px;height:26px;border-radius:8px;border:2px solid var(--line);display:flex;align-items:center;justify-content:center;
  font-family:'Baloo 2';font-weight:700;font-size:13px;color:var(--muted);flex-shrink:0}
.mimi-root .opt.right{border-color:var(--good);background:var(--good-bg)}
.mimi-root .opt.right .k{border-color:var(--good);background:var(--good);color:#fff}
.mimi-root .opt.wrong{border-color:var(--bad);background:var(--bad-bg)}
.mimi-root .opt.wrong .k{border-color:var(--bad);background:var(--bad);color:#fff}

.mimi-root .hint-wrap{margin-top:18px}
.mimi-root .hint-btn{width:100%;background:transparent;border:2px dashed var(--lav);color:var(--lav-deep);border-radius:14px;
  padding:11px;font-family:'Baloo 2';font-weight:700;font-size:14px;cursor:pointer}
.mimi-root .hint-btn:active{transform:translateY(1px)}
.mimi-root .hint-box{display:none;margin-top:10px;background:#fbf3e6;border:2px solid #f0e1b6;border-radius:14px;padding:13px 15px;
  font-weight:700;font-size:14px;line-height:1.5;color:#8c7327}
.mimi-root .hint-box.show{display:flex;gap:9px;animation:mimi-pop .3s ease}
.mimi-root .hint-box b{flex-shrink:0}

.mimi-root .btn{width:100%;font-family:'Baloo 2';font-weight:800;font-size:18px;color:#fff;background:var(--good);border:none;
  border-bottom:5px solid var(--good-deep);border-radius:16px;padding:15px;cursor:pointer;letter-spacing:.4px;transition:transform .07s,filter .15s}
.mimi-root .btn:hover{filter:brightness(1.04)}
.mimi-root .btn:active{transform:translateY(3px);border-bottom-width:2px}
.mimi-root .btn.lav{background:var(--lav-deep);border-bottom-color:#6f63a0}
.mimi-root .btn.ghost{background:rgba(255,255,255,.85);color:var(--lav-deep);border:2px solid var(--line);border-bottom-width:5px}
.mimi-root .btn-row{display:flex;gap:10px;margin-top:10px}

.mimi-sheet{position:fixed;left:0;right:0;bottom:0;z-index:20;transform:translateY(110%);transition:transform .35s cubic-bezier(.2,.9,.3,1.1)}
.mimi-sheet.up{transform:translateY(0)}
.mimi-sheet .sheet-inner{max-width:480px;margin:0 auto;border-radius:22px 22px 0 0;padding:18px 18px calc(20px + env(safe-area-inset-bottom));
  box-shadow:0 -8px 30px rgba(93,85,106,.18)}
.mimi-sheet.ok .sheet-inner{background:var(--good-bg,#e9f0dd)}
.mimi-sheet.no .sheet-inner{background:var(--bad-bg,#f7e6e6)}
.mimi-sheet .sheet-head{display:flex;align-items:center;gap:12px;margin-bottom:6px}
.mimi-sheet .sheet-head .mini{width:64px;flex-shrink:0}
.mimi-sheet .sheet-title{font-family:'Baloo 2';font-weight:800;font-size:21px}
.mimi-sheet.ok .sheet-title{color:#6f8c52}
.mimi-sheet.no .sheet-title{color:#c46b70}
.mimi-sheet .sheet-note{font-weight:700;font-size:14.5px;line-height:1.5;margin:2px 0 15px;padding-left:2px}
.mimi-sheet.ok .sheet-note{color:#5e7a3a}
.mimi-sheet.no .sheet-note{color:#a85a5e}
.mimi-sheet .btn{width:100%;font-family:'Baloo 2';font-weight:800;font-size:18px;color:#fff;background:#8caa6d;border:none;
  border-bottom:5px solid #6f8c52;border-radius:16px;padding:15px;cursor:pointer;letter-spacing:.4px;transition:transform .07s,filter .15s}
.mimi-sheet .btn:hover{filter:brightness(1.04)}
.mimi-sheet .btn:active{transform:translateY(3px);border-bottom-width:2px}
.mimi-sheet .btn.lav{background:#8f7fb8;border-bottom-color:#6f63a0}

.mimi-root .end{text-align:center}
.mimi-root .end h2{font-family:'Baloo 2';font-weight:800;font-size:28px;margin:6px 0 4px}
.mimi-root .end .funny{color:var(--muted);font-weight:700;font-size:15px;margin-bottom:20px}
.mimi-root .stats{display:flex;gap:9px;margin-bottom:20px}
.mimi-root .stat{flex:1;background:rgba(255,255,255,.9);border:2px solid var(--line);border-bottom-width:4px;border-radius:16px;padding:13px 6px}
.mimi-root .stat .n{font-family:'Baloo 2';font-weight:800;font-size:23px}
.mimi-root .stat.xp .n{color:#caa400}
.mimi-root .stat.acc .n{color:#8caa6d}
.mimi-root .stat.hp .n{color:#c46b70}
.mimi-root .stat .l{font-weight:800;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-top:2px}

.mimi-confetti{position:fixed;top:-12px;width:9px;height:9px;z-index:30;pointer-events:none;border-radius:2px}
@keyframes mimi-fall{to{transform:translateY(105vh) rotate(540deg);opacity:0}}
@media (prefers-reduced-motion:reduce){.mimi-root *{animation:none!important;transition:none!important}.mimi-sheet{transition:none!important}}
</style>

<div class="mimi-root">
  <div class="deco d1">🌿</div>
  <div class="deco d2">🦋</div>
  <div class="deco d3">🌸</div>
  <div class="deco d4">☁️</div>

  <div class="stage">
    <div class="top" id="mimiTop">
      <button class="back" onclick="mimiGame.toMap()">‹</button>
      <div class="bar"><div class="fill" id="mimiFill"></div></div>
      <div class="hearts" id="mimiHearts"></div>
    </div>
    <div class="lvtag" id="mimiLvtag"></div>

    <!-- COVER -->
    <section class="screen on cover" id="mimiCover">
      <div class="cover-frame">
        <span class="ribbon">VOL. 1 · PYTHON</span>
        <div id="mimiCoverMascot"></div>
        <div class="eyebrow">S' Mimi Series</div>
        <h1>Mimi <span class="pop">Codes!</span></h1>
        <p class="tag">Learn Python with a very fluffy pup 🐾</p>
        <div class="meta">
          <span class="m">🎓 10 sets</span><span class="m">🐍 100 questions</span><span class="m">🌱 freshman → pro</span>
        </div>
        <button class="btn" onclick="mimiGame.enter()">START THE COURSE →</button>
      </div>
    </section>

    <!-- MAP -->
    <section class="screen" id="mimiMap">
      <div id="mimiMapMascot"></div>
      <div class="hi"><h1>Mimi <span class="pop">Codes!</span></h1><p>10 sets, freshman → pro. Pick a lesson 🐾</p></div>
      <div class="prog" id="mimiProgressBanner"></div>
      <div class="map" id="mimiSetList"></div>
    </section>

    <!-- QUIZ -->
    <section class="screen" id="mimiQuiz">
      <div class="talk"><div class="mascot" id="mimiQMascot"></div><div class="bubble" id="mimiBubble"></div></div>
      <div class="kind" id="mimiKind"></div>
      <pre class="code" id="mimiCode"></pre>
      <div class="opts" id="mimiOpts"></div>
      <div class="hint-wrap">
        <button class="hint-btn" id="mimiHintBtn" onclick="mimiGame.toggleHint()">🐾 Need a paw? Tap for a hint</button>
        <div class="hint-box" id="mimiHintBox"><b>💡</b><span id="mimiHintText"></span></div>
      </div>
    </section>

    <!-- END -->
    <section class="screen end" id="mimiEnd">
      <div id="mimiEndMascot"></div>
      <h2 id="mimiEndTitle"></h2>
      <p class="funny" id="mimiEndFunny"></p>
      <div class="stats">
        <div class="stat xp"><div class="n" id="mimiXp">0</div><div class="l">XP</div></div>
        <div class="stat acc"><div class="n" id="mimiAcc">0%</div><div class="l">Correct</div></div>
        <div class="stat hp"><div class="n" id="mimiHp">5</div><div class="l">Hearts</div></div>
      </div>
      <button class="btn" id="mimiNextBtn" onclick="mimiGame.nextSet()">NEXT SET ▶</button>
      <div class="btn-row">
        <button class="btn ghost" onclick="mimiGame.replaySet()">REPLAY 🔁</button>
        <button class="btn ghost" onclick="mimiGame.toMap()">MAP 🗺️</button>
      </div>
    </section>
  </div>

  <div class="brand">S' Mimi Series 🐾</div>
</div>

<!-- Sheet lives outside .mimi-root so it can be fixed to the viewport -->
<div class="mimi-sheet" id="mimiSheet">
  <div class="sheet-inner">
    <div class="sheet-head"><div class="mini" id="mimiSheetMini"></div><div class="sheet-title" id="mimiSheetTitle"></div></div>
    <div class="sheet-note" id="mimiSheetNote"></div>
    <button class="btn" id="mimiSheetBtn" onclick="mimiGame.next()">CONTINUE</button>
  </div>
</div>

<script>
(function(){
/* ---------- Mimi mascot ---------- */
function mimi(mood){
  const fluff='#fdfbf7',shade='#e4ddec',warm='#efe6e0';
  const tail=`<g class="tail"><path d="M150 120 q34 -6 30 26 q-2 22 -26 14 q-18 -6 -10 -28 z" fill="${fluff}"/><path d="M156 124 q22 -2 20 18" fill="none" stroke="${shade}" stroke-width="2.5" stroke-linecap="round"/></g>`;

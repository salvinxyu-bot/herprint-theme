    {q:`print([x for row in [[1, 2], [3, 4]] for x in row])`,o:['[1, 2, 3, 4]','[[1, 2], [3, 4]]','[1, 3]','[4, 3, 2, 1]'],a:0,h:'A nested comp flattens the rows.',n:'[1, 2, 3, 4].'},
    {q:`print("  Hi ".strip().lower())`,o:['hi','Hi','HI','error'],a:0,h:'strip() trims spaces, lower() lowercases.',n:'Chained → hi.'},
    {q:`words = "a b a c a".split()\nprint(words.count("a"))`,o:['3','5','2','1'],a:0,h:'count() tallies how many times "a" appears.',n:'Three a’s → 3.'},
    {q:`pairs = [(1, "b"), (2, "a")]\nprint(sorted(pairs, key=lambda p: p[1]))`,o:["[(2, 'a'), (1, 'b')]","[(1, 'b'), (2, 'a')]","[(1, 'a'), (2, 'b')]",'error'],a:0,h:'Sort by the second item (the letter).',n:"a before b → [(2, 'a'), (1, 'b')]."},
    {q:`print(f"{3.14159:.2f}")`,o:['3.14','3.141','3.1','3.14159'],a:0,h:'.2f rounds to 2 decimal places.',n:'3.14 — and you finished the course! 🎓🏆'},
  ]},
];

const BUBBLES=["What does this print? 🤔","Read it with me 🐾","Your turn! ✨","Hmm, what's the output? 🔍","Take a guess! 💭","You've got this 💪"];
const CHEERS=["Woof! Nailed it. 🎉","Big brain energy. 🧠","Tail = helicopter. 🚁","Chef's kiss. 🐾","Painted perfectly. 🎨","Too easy for you. 😎"];
const OOPS=["Oof, I sneezed. 🤧","Sooo close! 😵","Not that one — next! 💪","Tuck it away for later. 🧐","My bad, I wagged too hard. 🐕"];
const KEYS=['A','B','C','D'];

const STORE_KEY='mimiCodesProgress';
const _mem={};
function loadBest(){try{const r=localStorage.getItem(STORE_KEY);return r?JSON.parse(r):{};}catch(e){return _mem.best||{};}}
function saveBest(b){try{localStorage.setItem(STORE_KEY,JSON.stringify(b));}catch(e){_mem.best=b;}}
let best=loadBest();
function starsFor(b){return b>=10?3:b>=9?2:b>=7?1:0;}
function progressStats(){
  let cleared=0,stars=0,xp=0;
  SETS.forEach((s,i)=>{const b=best[i]||0;if(b>=7)cleared++;stars+=starsFor(b);xp+=b*10;});
  return{cleared,stars,xp,perfect:SETS.every((s,i)=>(best[i]||0)===10)};
}
function resetProgress(){best={};saveBest(best);mimiGame.renderMap();}

const mimiGame={si:0,i:0,score:0,hearts:5,locked:false,

  toMap(){
    document.getElementById('mimiTop').style.visibility='hidden';
    document.getElementById('mimiLvtag').style.visibility='hidden';
    document.getElementById('mimiSheet').classList.remove('up');
    this.renderMap();flipTo('mimiMap');
  },

  enter(){this.renderMap();fadeTo('mimiMap');},

  renderMap(){
    document.getElementById('mimiMapMascot').innerHTML=`<div class="mascot big bob">${mimi('happy')}</div>`;
    const st=progressStats();
    document.getElementById('mimiProgressBanner').innerHTML=
      `<div class="prog-row">
        <div><div class="prog-big">${st.cleared}<span>/10</span></div><div class="prog-sub">sets cleared</div></div>
        <div class="prog-stats"><div>⭐ ${st.stars} stars</div><div>✨ ${st.xp} XP</div></div>
      </div>
      <div class="prog-bar"><div class="prog-fill" style="width:${st.cleared/10*100}%"></div></div>
      ${st.perfect?'<div class="badge-perfect">🏅 PERFECT RUN · all 30 stars ✨</div>':''}
      ${st.cleared||st.xp?'<button class="prog-reset" onclick="resetProgress()">reset progress</button>':''}`;
    const list=document.getElementById('mimiSetList');list.innerHTML='';
    SETS.forEach((s,idx)=>{
      const b=best[idx]||0,stars=starsFor(b);
      const unlocked=idx===0||(best[idx-1]||0)>=7;
      const right=!unlocked
        ?`<div class="cright"><div class="lock">🔒</div></div>`
        :(idx in best)
          ?`<div class="cright"><div class="cstars">${stars?'⭐'.repeat(stars):(b>=7?'✓':'·')}</div><div class="cbest">${b}/10</div></div>`
          :`<div class="cright"><div class="cgo">›</div></div>`;
      const c=document.createElement('div');c.className='setcard'+(unlocked?'':' locked');
      if(unlocked)c.onclick=()=>this.startSet(idx);
      else c.onclick=()=>{c.classList.remove('deny');void c.offsetWidth;c.classList.add('deny');};
      c.innerHTML=`<div class="num" style="background:${unlocked?s.color:'#c7c0d2'}">${idx+1}</div>
        <div class="setinfo"><div class="tier">${s.tier}</div><div class="nm">${s.nm}</div></div>
        ${right}`;
      list.appendChild(c);
    });
  },

  startSet(si){
    if(!(si===0||(best[si-1]||0)>=7))return;
    this.si=si;this.i=0;this.score=0;this.hearts=5;this.locked=false;
    document.getElementById('mimiTop').style.visibility='visible';
    document.getElementById('mimiLvtag').style.visibility='visible';
    this.drawHearts();this.render();flipTo('mimiQuiz');
  },
  replaySet(){this.startSet(this.si);},
  nextSet(){const nx=this.si+1;if(nx<SETS.length&&(best[this.si]||0)>=7)this.startSet(nx);else this.toMap();},

  drawHearts(){
    const h=document.getElementById('mimiHearts');h.innerHTML='';
    for(let k=0;k<5;k++){const s=document.createElement('span');s.className='h'+(k>=this.hearts?' gone':'');s.textContent='💗';h.appendChild(s);}
  },

  render(){
    this.locked=false;const set=SETS[this.si];const q=set.qs[this.i];
    document.getElementById('mimiFill').style.width=(this.i/set.qs.length*100)+'%';
    document.getElementById('mimiLvtag').textContent=`SET ${this.si+1} · ${set.nm.toUpperCase()} · Q${this.i+1}/10`;
    const m=document.getElementById('mimiQMascot');m.innerHTML=mimi('idle');m.className='mascot bob';
    document.getElementById('mimiBubble').textContent=BUBBLES[this.i%BUBBLES.length];
    document.getElementById('mimiKind').textContent=`${set.tier} · Q${this.i+1} of 10`;
    document.getElementById('mimiCode').innerHTML=colorize(q.q);
    const opts=document.getElementById('mimiOpts');opts.innerHTML='';
    q.o.forEach((o,idx)=>{
      const b=document.createElement('button');b.className='opt';
      b.innerHTML=`<span class="k">${KEYS[idx]}</span><span>${esc(o)}</span>`;
      b.onclick=()=>this.answer(idx,b);opts.appendChild(b);
    });
    document.getElementById('mimiHintBox').className='hint-box';
    document.getElementById('mimiHintText').textContent=q.h;
    document.getElementById('mimiHintBtn').style.display='block';
  },

  toggleHint(){document.getElementById('mimiHintBox').classList.toggle('show');},

  answer(idx,btn){
    if(this.locked)return;this.locked=true;const q=SETS[this.si].qs[this.i];
    const correct=idx===q.a;
    [...document.getElementById('mimiOpts').children].forEach(b=>b.disabled=true);
    document.getElementById('mimiOpts').children[q.a].classList.add('right');
    document.getElementById('mimiHintBtn').style.display='none';
    const m=document.getElementById('mimiQMascot');
    if(correct){
      this.score++;m.innerHTML=mimi('cheer');m.className='mascot cheer';burst();
      this.openSheet(true,pick(CHEERS),q.n);
    } else {
      btn.classList.add('wrong');this.hearts=Math.max(0,this.hearts-1);this.drawHearts();
      m.innerHTML=mimi('oops');m.className='mascot shake';
      this.openSheet(false,pick(OOPS),'Answer: '+q.o[q.a]+'. '+q.n);
    }
  },

  openSheet(ok,title,note){
    const s=document.getElementById('mimiSheet');s.className='mimi-sheet '+(ok?'ok':'no');
    document.getElementById('mimiSheetMini').innerHTML=mimi(ok?'happy':'oops');
    document.getElementById('mimiSheetTitle').textContent=title;
    document.getElementById('mimiSheetNote').textContent=note;
    document.getElementById('mimiSheetBtn').className='btn'+(ok?'':' lav');
    document.getElementById('mimiSheetBtn').textContent=(this.i===SETS[this.si].qs.length-1)?'FINISH 🏁':'CONTINUE';
    requestAnimationFrame(()=>s.classList.add('up'));
  },

  next(){
    document.getElementById('mimiSheet').classList.remove('up');
    if(this.i<SETS[this.si].qs.length-1){this.i++;setTimeout(()=>this.render(),200);}
    else setTimeout(()=>this.finish(),200);
  },

  finish(){
    document.getElementById('mimiFill').style.width='100%';
    document.getElementById('mimiTop').style.visibility='hidden';
    document.getElementById('mimiLvtag').style.visibility='hidden';
    const set=SETS[this.si],total=set.qs.length,pct=Math.round(this.score/total*100);
    if(this.score>(best[this.si]||0)){best[this.si]=this.score;saveBest(best);}
    document.getElementById('mimiXp').textContent=this.score*10;
    document.getElementById('mimiAcc').textContent=pct+'%';
    document.getElementById('mimiHp').textContent=this.hearts;
    const last=this.si===SETS.length-1;
    const cleared=(best[this.si]||0)>=7;
    let title,funny,mood='cheer';
    if(pct===100){title='MASTERPIECE! 🏆';funny=last?'You finished the WHOLE course. Mimi is so proud. 🎓':'Flawless set — Mimi is doing zoomies!';}
    else if(pct>=70){title='Good girl! 🌸';funny='Set cleared! The next lesson just unlocked. 🔓';}
    else{title='Nice try! 🐾';funny='Get 70% to clear it — replay and unlock the next set!';mood='happy';}
    if(progressStats().perfect){title='🏅 PERFECT RUN!';funny='All ten sets, three stars each. You are a certified Python pro! 🎓';mood='cheer';burst();}
    document.getElementById('mimiEndMascot').innerHTML=`<div class="mascot big cheer">${mimi(mood)}</div>`;
    document.getElementById('mimiEndTitle').textContent=title;
    document.getElementById('mimiEndFunny').textContent=funny;
    const nb=document.getElementById('mimiNextBtn');
    nb.style.display=(!last&&cleared)?'block':'none';
    show('mimiEnd');
  }
};

function show(id){
  document.querySelectorAll('.mimi-root .screen').forEach(s=>s.classList.remove('on'));
  document.getElementById(id).classList.add('on');
  window.scrollTo({top:0,behavior:'smooth'});
}
const REDUCE=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
function flipTo(id){
  const cur=document.querySelector('.mimi-root .screen.on');
  const next=document.getElementById(id);
  if(!cur||cur===next){show(id);return;}
  if(REDUCE){show(id);return;}
  window.scrollTo({top:0});
  next.classList.add('on','flip-in');
  cur.classList.remove('on');cur.classList.add('flip-out');
  let cleaned=false;
  const done=()=>{if(cleaned)return;cleaned=true;cur.classList.remove('flip-out');next.classList.remove('flip-in');};
  cur.addEventListener('animationend',done,{once:true});
  setTimeout(done,720);
}
function fadeTo(id){
  const cur=document.querySelector('.mimi-root .screen.on');
  const next=document.getElementById(id);
  if(!cur||cur===next){show(id);return;}
  if(REDUCE){show(id);return;}
  window.scrollTo({top:0});
  next.classList.add('on','fade-in');
  cur.classList.remove('on');cur.classList.add('fade-out');
  let cleaned=false;
  const done=()=>{if(cleaned)return;cleaned=true;cur.classList.remove('fade-out');next.classList.remove('fade-in');};
  cur.addEventListener('animationend',done,{once:true});
  setTimeout(done,560);
}
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function pick(a){return a[Math.floor(Math.random()*a.length)];}
function colorize(code){
  let c=esc(code).replace(/___/g,'<span class="blank">___</span>');
  c=c.replace(/(&quot;|").*?(&quot;|")/g,m=>`<span class="lit">${m}</span>`);
  c=c.replace(/\b(print|range|len|list|map|filter|sum|sorted|set|str|int|enumerate|zip|reduce|all)\b/g,'<span class="fn">$1</span>');
  c=c.replace(/\b(for|in|if|else|elif|def|return|lambda|and|or|not|while|break|continue|try|except|from|import|pass)\b/g,'<span class="kw">$1</span>');
  return c;
}
function burst(){
  const cols=['#a9c2a0','#b6a9d4','#efc1c8','#f3e2a6','#a9c5e0'];
  for(let k=0;k<26;k++){
    const d=document.createElement('div');d.className='mimi-confetti';
    d.style.left=Math.random()*100+'vw';d.style.background=cols[k%cols.length];
    d.style.animation=`mimi-fall ${1+Math.random()*0.8}s linear forwards`;d.style.animationDelay=Math.random()*0.2+'s';
    if(k%2)d.style.borderRadius='50%';document.body.appendChild(d);setTimeout(()=>d.remove(),2200);
  }
}

document.getElementById('mimiCoverMascot').innerHTML=`<div class="mascot big bob">${mimi('happy')}</div>`;
mimiGame.renderMap();
})();
</script>


      "label": "Poem font size (rem)",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.6
    },
    {
      "type": "color",
      "id": "poem_color",
      "label": "Poem text color",
      "default": "#2a2a2a"
    },
    {
      "type": "text",
      "id": "poem_credit",
      "label": "Poem credit",
      "default": "Herprint"
    },
    {
      "type": "color",
      "id": "poem_credit_color",
      "label": "Credit color",
      "default": "#7f6464"
    },
    {
      "type": "header",
      "content": "Images / GIFs (beside poem)"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image / GIF 1"
    },
    {
      "type": "text",
      "id": "caption_1",
      "label": "Caption 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image / GIF 2"
    },
    {
      "type": "text",
      "id": "caption_2",
      "label": "Caption 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image / GIF 3"
    },
    {
      "type": "text",
      "id": "caption_3",
      "label": "Caption 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image / GIF 4"
    },
    {
      "type": "text",
      "id": "caption_4",
      "label": "Caption 4"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Caption color",
      "default": "#7f6464"
    },
    {
      "type": "header",
      "content": "Brand Story Text"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Herprint was born from a simple belief — that jewelry is not decoration. It is memory. It is identity. It is the quiet language of a life fully lived.</p><p>Every piece we make is solid gold, handcrafted in small batches, designed to become yours the moment you put it on.</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#4a4a4a"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_tagline",
      "label": "Tagline above button",
      "default": "Jewelry that marks your every becoming."
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Tagline color",
      "default": "#2a2a2a"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop the Collection"

<div class="invite-block color-{{ section.settings.color_scheme }} gradient" style="--invite-accent: {{ section.settings.accent_color }};">
  <div class="invite-block__inner">

    <span class="invite-tag">{{ section.settings.tag }}</span>
    <h2 class="invite-block__title">{{ section.settings.title }}</h2>
    <p class="invite-block__lead">{{ section.settings.lead }}</p>

    {%- if section.blocks.size > 0 -%}
      <div class="invite-perks">
        {%- for block in section.blocks -%}
          {%- if block.type == 'perk' -%}
            <div class="invite-perk" {{ block.shopify_attributes }}>
              <span class="invite-perk__icon">{{ block.settings.icon }}</span>
              <h3 class="invite-perk__title">{{ block.settings.title }}</h3>
              <p class="invite-perk__text">{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign eligibility_items = section.blocks | where: 'type', 'eligibility' -%}
    {%- if eligibility_items.size > 0 -%}
      <div class="invite-eligibility">
        <p class="invite-eligibility__title">{{ section.settings.eligibility_heading }}</p>
        <ul class="invite-eligibility__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'eligibility' -%}
              <li class="invite-eligibility__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <a href="{{ section.settings.cta_link }}" class="invite-cta">{{ section.settings.cta_label }}</a>
    <a href="mailto:{{ section.settings.email }}" class="invite-cta invite-cta--ghost">{{ section.settings.email_label }}</a>

  </div>
</div>

{% schema %}
{
  "name": "Invite — Muse",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-636b8a2b-0e73-4da9-8c5d-94025a339392"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#7f6464"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Section tag",
      "default": "Herprint Muse"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "For the creators who move culture."
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead text",
      "default": "If you create content around fashion, beauty, lifestyle or jewelry — and your community trusts you — we want to gift you a Herprint experience. No strings. Just jewelry that fits your story."
    },
    {
      "type": "text",
      "id": "eligibility_heading",
      "label": "Eligibility box heading",
      "default": "You may qualify if you —"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button",
      "default": "Apply as a Muse"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "default": "muse@herprint.co"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email button label",
      "default": "Email us directly"
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    },
    {
      "type": "eligibility",
      "name": "Eligibility Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Requirement" }
      ]
    }
  ],
  "presets": [{
    "name": "Invite — Muse",
    "blocks": [
      { "type": "perk", "settings": { "icon": "✦", "title": "Free Experience", "text": "Receive a Herprint coupon to shop our collection, completely on us." } },
      { "type": "perk", "settings": { "icon": "◇", "title": "No Obligation", "text": "We ask nothing in return. If you love it and want to share, we'd be honoured." } },
      { "type": "perk", "settings": { "icon": "○", "title": "Ongoing Partnership", "text": "Great fits become long-term Herprint friends — with early access, custom pieces, and more." } },
      { "type": "eligibility", "settings": { "text": "Have 10,000+ followers on any single platform" } },
      { "type": "eligibility", "settings": { "text": "Create in fashion, beauty, lifestyle or jewelry" } },
      { "type": "eligibility", "settings": { "text": "Are active on YouTube, Instagram or TikTok" } },
      { "type": "eligibility", "settings": { "text": "Have an engaged, authentic community" } }
    ]
  }]
}
{% endschema %}

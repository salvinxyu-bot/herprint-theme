{% comment %}
  Renders the "Try it on" button + modal for a product.
  Usage: {% render 'jewelry-tryon', product: product %}

  Optional product metafields (namespace `tryon`):
    - tryon.overlay   (image)  transparent PNG cutout of the piece; overrides the
                               product photo and disables auto background removal.
    - tryon.height_mm (number) real height of the piece in millimetres (default 30).
{% endcomment %}

{%- liquid
  assign overlay_image = product.metafields.tryon.overlay.value
  assign keyout = true
  if overlay_image != blank
    assign overlay_url = overlay_image | image_url: width: 500
    assign keyout = false
  elsif product.featured_image != blank
    assign overlay_url = product.featured_image | image_url: width: 500
  endif
  assign height_mm = product.metafields.tryon.height_mm.value | default: 30
  assign current_variant = product.selected_or_first_available_variant
-%}

{%- if overlay_url != blank -%}
  <jewelry-tryon class="tryon" data-section-id="{{ section.id }}">
    <script type="application/json" data-tryon-config>
      {
        "overlayUrl": {{ overlay_url | json }},
        "heightMm": {{ height_mm | json }},
        "keyout": {{ keyout | json }},
        "handle": {{ product.handle | json }},
        "overlaysUrl": {{ 'tryon-overlays.json' | asset_url | json }},
        "variantId": {{ current_variant.id | json }},
        "addUrl": {{ routes.cart_add_url | json }}
      }
    </script>

    <button type="button" class="tryon__trigger" data-tryon-open>
      <span class="tryon__trigger-icon" aria-hidden="true">{{ 'icon-eye.svg' | inline_asset_content }}</span>
      {{ button_label | default: 'See it on me' | escape }}
    </button>

    <div class="tryon__modal" data-tryon-modal role="dialog" aria-modal="true" aria-label="Virtual try-on" hidden>
      <div class="tryon__dialog">
        <button type="button" class="tryon__close" data-tryon-close aria-label="Close try-on">
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>

        <div class="tryon__head">
          <h2 class="tryon__title">Try on {{ product.title | escape }}</h2>
          <p class="tryon__privacy">
            <span class="tryon__lock" aria-hidden="true">{{ 'icon-padlock.svg' | inline_asset_content }}</span>
            Your photo stays on your device — nothing is uploaded.
          </p>
        </div>

        <div class="tryon__stage">
          <canvas class="tryon__canvas" data-tryon-canvas width="460" height="460"></canvas>
          <video class="tryon__video" data-tryon-video playsinline muted></video>
          <p class="tryon__status" data-tryon-status role="status" aria-live="polite"></p>
        </div>

        <div class="tryon__actions">
          <button type="button" class="tryon__action" data-tryon-upload-btn>
            <span aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
            Upload a photo
          </button>
          <button type="button" class="tryon__action" data-tryon-camera-btn>
            Use my camera
          </button>
          <input type="file" accept="image/*" data-tryon-file hidden>
        </div>

        <div class="tryon__controls" data-tryon-controls hidden>
          <label class="tryon__control">
            <span>Size</span>
            <input type="range" min="0.6" max="1.6" step="0.02" value="1" data-tryon-size>
          </label>
          <label class="tryon__control">
            <span>Position</span>
            <input type="range" min="-0.04" max="0.08" step="0.005" value="0" data-tryon-offset>
          </label>
          <label class="tryon__control">
            <span>Rotate</span>
            <input type="range" min="-30" max="30" step="1" value="0" data-tryon-rotate>
          </label>
        </div>

        <div class="tryon__footer">
          <span class="tryon__price">{{ current_variant.price | money }}</span>
          <button type="button" class="tryon__add button" data-tryon-add>Add to bag</button>
        </div>
      </div>
    </div>
  </jewelry-tryon>

  <script type="module" src="{{ 'jewelry-tryon.js' | asset_url }}"></script>
{%- endif -%}

{% stylesheet %}
  .tryon__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 1.2rem 0;
    padding: 1rem 1.8rem;
    background: transparent;
    border: 0.1rem solid #7f6464;
    border-radius: 4rem;
    color: #7f6464;
    font-size: 1.4rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .tryon__trigger:hover {
    background: #7f6464;
    color: #fafaf7;
  }

  .tryon__trigger-icon svg,
  .tryon__close svg,
  .tryon__lock svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .tryon__modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgba(42, 32, 32, 0.55);
  }

  .tryon__modal.is-open {
    display: flex;
  }

  .tryon__modal[hidden] {
    display: none;
  }

  .tryon__modal.is-open[hidden] {
    display: flex;
  }

  .tryon__dialog {
    position: relative;
    width: 100%;
    max-width: 540px;
    max-height: 92vh;
    overflow-y: auto;
    padding: 2.4rem;
    background: #fafaf7;
    border-radius: 0.8rem;
    text-align: center;
  }

  .tryon__close {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    display: inline-flex;
    padding: 0.6rem;
    background: transparent;
    border: 0;
    color: #2a2a2a;
    cursor: pointer;
  }

  .tryon__title {
    margin: 0 0 0.6rem;
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: 400;
  }

  .tryon__privacy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 1.6rem;
    font-size: 1.2rem;
    color: #7f6464;
  }

  .tryon__stage {
    position: relative;
    min-height: 28rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #f0ece6;
    border-radius: 0.6rem;
    overflow: hidden;
  }

  .tryon__canvas {
    max-width: 100%;
    height: auto;
  }

  .tryon__video {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .tryon__status {
    margin: 0;
    padding: 1.2rem;
    font-size: 1.3rem;
    color: #2a2a2a;
  }

  .tryon__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin: 1.6rem 0 0;
  }

  .tryon__action {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.6rem;
    background: #2a2020;
    border: 0;
    border-radius: 4rem;
    color: #fafaf7;
    font-size: 1.3rem;
    cursor: pointer;
  }

  .tryon__action svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .tryon__action:hover {
    background: #7f6464;
  }

  .tryon__controls {
    display: grid;
    gap: 1rem;
    margin: 1.6rem auto 0;
    max-width: 32rem;
  }

  .tryon__control {
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: center;
    gap: 1rem;
    font-size: 1.3rem;
    text-align: left;
  }

  .tryon__control input[type='range'] {
    width: 100%;
    accent-color: #7f6464;
  }

  .tryon__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.4rem;
    margin-top: 2rem;
  }

  .tryon__price {
    font-size: 1.6rem;
    color: #2a2a2a;
  }

  .tryon__add {
    cursor: pointer;
  }
{% endstylesheet %}

{% stylesheet %}
  .faq-page {
    max-width: 840px;
    margin: 0 auto;
    padding: 7rem 2rem 10rem;
  }

  .faq-page__header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .faq-page__eyebrow {
    display: block;
    font-size: 1.1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.6rem;
    color: var(--faq-accent, rgb(var(--color-button)));
  }

  .faq-page__title {
    font-family: var(--font-heading-family);
    font-size: clamp(3.2rem, 5vw, 5.4rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 1.8rem;
    letter-spacing: -0.01em;
    color: rgb(var(--color-foreground));
  }

  .faq-page__intro {
    font-size: 1.6rem;
    line-height: 1.8;
    opacity: 0.75;
    max-width: 540px;
    margin: 0 auto;
    color: rgb(var(--color-foreground));
  }

  .faq-category {
    margin-top: 5.5rem;
  }

  .faq-category__title {
    font-size: 1.2rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--faq-accent, rgb(var(--color-button)));
    padding-bottom: 1.2rem;
    margin: 0;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.18);
  }

  .faq-item {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .faq-item__summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    cursor: pointer;
    padding: 2.2rem 0;
    list-style: none;
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 400;
    line-height: 1.4;
    color: rgb(var(--color-foreground));
  }

  .faq-item__summary::-webkit-details-marker {
    display: none;
  }

  .faq-item__summary:hover {
    color: var(--faq-accent, rgb(var(--color-button)));
  }

  .faq-item__icon {
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    position: relative;
  }

  .faq-item__icon::before,
  .faq-item__icon::after {
    content: '';
    position: absolute;
    background: var(--faq-accent, rgb(var(--color-button)));
    transition: transform 0.25s ease;
  }

  .faq-item__icon::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    transform: translateY(-50%);
  }

  .faq-item__icon::after {
    left: 50%;
    top: 0;
    width: 1.5px;
    height: 100%;
    transform: translateX(-50%);
  }

  .faq-item[open] .faq-item__icon::after {
    transform: translateX(-50%) scaleY(0);
  }

  .faq-item__answer {
    padding: 0 0 2.4rem;
    font-size: 1.5rem;
    line-height: 1.85;
    opacity: 0.82;
    max-width: 700px;
    color: rgb(var(--color-foreground));
  }

  .faq-item__answer p {
    margin: 0 0 1.2rem;
  }

  .faq-item__answer p:last-child {
    margin-bottom: 0;
  }

  .faq-item__answer a {
    color: var(--faq-accent, rgb(var(--color-button)));
    text-underline-offset: 3px;
  }

  .faq-page__cta {
    text-align: center;
    margin-top: 6.5rem;
    padding-top: 5rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .faq-page__cta-text {
    font-family: var(--font-heading-family);
    font-style: italic;
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 400;
    margin-bottom: 2.4rem;
    color: rgb(var(--color-foreground));
  }

  .faq-page__cta-btn {
    display: inline-block;
    padding: 1.4rem 3.6rem;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-label));
    font-size: 1.2rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid rgb(var(--color-button));
    transition: background 0.2s ease, color 0.2s ease;
  }

  .faq-page__cta-btn:hover {
    background: transparent;
    color: rgb(var(--color-button));
  }
{% endstylesheet %}

<div class="faq-page color-{{ section.settings.color_scheme }} gradient" style="--faq-accent: {{ section.settings.accent_color }};">
  <div class="faq-page__header">
    {%- if section.settings.eyebrow != blank -%}
      <span class="faq-page__eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h1 class="faq-page__title">{{ section.settings.title | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="faq-page__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'category' -%}
        <div class="faq-category" {{ block.shopify_attributes }}>
          <h2 class="faq-category__title">{{ block.settings.title | escape }}</h2>
        </div>
      {%- when 'question' -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary class="faq-item__summary">
            <span>{{ block.settings.question | escape }}</span>
            <span class="faq-item__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-item__answer rte">{{ block.settings.answer }}</div>
        </details>
    {%- endcase -%}
  {%- endfor -%}

  {%- if section.settings.show_cta -%}
    <div class="faq-page__cta">
      {%- if section.settings.cta_text != blank -%}
        <p class="faq-page__cta-text">{{ section.settings.cta_text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="faq-page__cta-btn">
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "FAQ Page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#7f6464"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Help Center"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Everything you need to know about our jewelry, orders, and care. Can't find your answer? We're always an email away."
    },
    {
      "type": "header",
      "content": "Contact CTA"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show contact CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA tagline",
      "default": "Still have a question?"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "Category"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Page",
      "blocks": [
        { "type": "category", "settings": { "title": "Shipping & Delivery" } },
        { "type": "question", "settings": { "question": "Do you ship internationally?", "answer": "<p>Yes! We offer worldwide shipping. Delivery times typically range from 7–15 business days, depending on your location.</p>" } },
        { "type": "question", "settings": { "question": "How can I track my order?", "answer": "<p>Once your order ships, you'll receive an email with a tracking link so you can follow it every step of the way.</p>" } },
        { "type": "category", "settings": { "title": "Returns & Exchanges" } },
        { "type": "question", "settings": { "question": "What is your return policy?", "answer": "<p>We accept returns on most items within 14 days of delivery. Items must be in their original packaging and unworn.</p>" } },
        { "type": "category", "settings": { "title": "Jewelry Care" } },
        { "type": "question", "settings": { "question": "How do I care for my Herprint jewelry?", "answer": "<p>To maintain the high brilliance of your 14k gold plating and natural zircon, avoid contact with water, perfumes, and lotions.</p>" } }
      ]
    }
  ]
}
{% endschema %}

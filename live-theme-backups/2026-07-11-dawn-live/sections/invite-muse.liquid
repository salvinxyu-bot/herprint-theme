{% stylesheet %}
  .invite-block {
    padding: 9rem 2rem;
  }

  .invite-block__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .invite-tag {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    margin-bottom: 2.4rem;
  }

  .invite-block__title {
    line-height: 1.15;
    margin-bottom: 2.4rem;
    max-width: 640px;
  }

  .invite-block__lead {
    line-height: 1.85;
    max-width: 620px;
    margin-bottom: 4rem;
  }

  .invite-perks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    margin-bottom: 5rem;
  }

  @media screen and (min-width: 750px) {
    .invite-perks { grid-template-columns: repeat(3, 1fr); }
  }

  .invite-perk {
    background: rgba(var(--color-foreground), 0.04);
    border: 1px solid rgba(var(--color-foreground), 0.1);
    padding: 3rem 2.4rem;
  }

  .invite-perk__icon {
    margin-bottom: 1.2rem;
    display: block;
  }

  .invite-perk__title {
    margin-bottom: 0.8rem;
  }

  .invite-perk__text {
    line-height: 1.7;
  }

  .invite-eligibility {
    background: rgba(var(--color-foreground), 0.05);
    padding: 3.6rem;
    margin-bottom: 4rem;
  }

  .invite-eligibility__title {
    margin-bottom: 1.6rem;
  }

  .invite-eligibility__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }

  @media screen and (min-width: 750px) {
    .invite-eligibility__list { grid-template-columns: repeat(2, 1fr); }
  }

  .invite-eligibility__item {
    padding-left: 1.6rem;
    position: relative;
    line-height: 1.6;
  }

  .invite-eligibility__item::before {
    content: '\2726';
    position: absolute;
    left: 0;
    font-size: 0.9rem;
    top: 0.4rem;
    color: var(--invite-accent, rgb(var(--color-button)));
  }

  .invite-cta {
    display: inline-block;
    padding: 1.4rem 3.6rem;
    text-decoration: none;
    margin-right: 1.6rem;
    margin-bottom: 1.6rem;
    border: 1px solid transparent;
    transition: background 0.2s, color 0.2s;
  }

  .invite-cta--ghost {
    background: transparent;
  }
{% endstylesheet %}

{%- liquid
  assign tag_font = section.settings.tag_font
  assign title_font = section.settings.title_font
  assign lead_font = section.settings.lead_font
  assign perk_title_font = section.settings.perk_title_font
  assign perk_text_font = section.settings.perk_text_font
  assign elig_heading_font = section.settings.elig_heading_font
  assign elig_item_font = section.settings.elig_item_font
  assign btn_font = section.settings.btn_font

  assign title_min = section.settings.title_size | times: 0.6 | round
  assign lead_min = section.settings.lead_size | times: 0.7 | round
-%}

{% style %}
  {{ tag_font | font_face: font_display: 'swap' }}
  {{ title_font | font_face: font_display: 'swap' }}
  {{ lead_font | font_face: font_display: 'swap' }}
  {{ perk_title_font | font_face: font_display: 'swap' }}
  {{ perk_text_font | font_face: font_display: 'swap' }}
  {{ elig_heading_font | font_face: font_display: 'swap' }}
  {{ elig_item_font | font_face: font_display: 'swap' }}
  {{ btn_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .invite-tag {
    font-family: {{ tag_font.family }}, {{ tag_font.fallback_families }};
    font-weight: {{ tag_font.weight }};
    font-style: {{ tag_font.style }};
    font-size: {{ section.settings.tag_size }}px;
    letter-spacing: {{ section.settings.tag_spacing }}em;
    text-transform: {{ section.settings.tag_transform }};
    color: {{ section.settings.tag_color }};
    background-color: {{ section.settings.accent_color }};
  }
  #shopify-section-{{ section.id }} .invite-block__title {
    font-family: {{ title_font.family }}, {{ title_font.fallback_families }};
    font-weight: {{ title_font.weight }};
    font-style: {{ title_font.style }};
    font-size: clamp({{ title_min }}px, 4.5vw, {{ section.settings.title_size }}px);
    letter-spacing: {{ section.settings.title_spacing }}em;
    color: {{ section.settings.title_color }};
  }
  #shopify-section-{{ section.id }} .invite-block__lead {
    font-family: {{ lead_font.family }}, {{ lead_font.fallback_families }};
    font-weight: {{ lead_font.weight }};
    font-style: {{ lead_font.style }};
    font-size: clamp({{ lead_min }}px, 2.2vw, {{ section.settings.lead_size }}px);
    color: {{ section.settings.lead_color }};
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .invite-perk__icon {
    font-size: {{ section.settings.icon_size }}px;
    color: {{ section.settings.icon_color }};
  }
  #shopify-section-{{ section.id }} .invite-perk__title {
    font-family: {{ perk_title_font.family }}, {{ perk_title_font.fallback_families }};
    font-weight: {{ perk_title_font.weight }};
    font-style: {{ perk_title_font.style }};
    font-size: {{ section.settings.perk_title_size }}px;
    color: {{ section.settings.perk_title_color }};
  }
  #shopify-section-{{ section.id }} .invite-perk__text {
    font-family: {{ perk_text_font.family }}, {{ perk_text_font.fallback_families }};
    font-weight: {{ perk_text_font.weight }};
    font-style: {{ perk_text_font.style }};
    font-size: {{ section.settings.perk_text_size }}px;
    color: {{ section.settings.perk_text_color }};
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .invite-eligibility__title {
    font-family: {{ elig_heading_font.family }}, {{ elig_heading_font.fallback_families }};
    font-weight: {{ elig_heading_font.weight }};
    font-style: {{ elig_heading_font.style }};
    font-size: {{ section.settings.elig_heading_size }}px;
    letter-spacing: {{ section.settings.elig_heading_spacing }}em;
    text-transform: {{ section.settings.elig_heading_transform }};
    color: {{ section.settings.elig_heading_color }};
  }
  #shopify-section-{{ section.id }} .invite-eligibility__item {
    font-family: {{ elig_item_font.family }}, {{ elig_item_font.fallback_families }};
    font-weight: {{ elig_item_font.weight }};
    font-style: {{ elig_item_font.style }};
    font-size: {{ section.settings.elig_item_size }}px;
    color: {{ section.settings.elig_item_color }};
  }
  #shopify-section-{{ section.id }} .invite-cta {
    font-family: {{ btn_font.family }}, {{ btn_font.fallback_families }};
    font-weight: {{ btn_font.weight }};
    font-style: {{ btn_font.style }};
    font-size: {{ section.settings.btn_size }}px;
    letter-spacing: {{ section.settings.btn_spacing }}em;
    text-transform: {{ section.settings.btn_transform }};
    background: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
    border-color: {{ section.settings.btn_bg_color }};
  }
  #shopify-section-{{ section.id }} .invite-cta:hover {
    background: transparent;
    color: {{ section.settings.btn_bg_color }};
  }
  #shopify-section-{{ section.id }} .invite-cta--ghost {
    background: transparent;
    color: {{ section.settings.btn_text_color_ghost }};
    border-color: {{ section.settings.btn_bg_color }};
  }
  #shopify-section-{{ section.id }} .invite-cta--ghost:hover {
    background: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_text_color }};
  }
{% endstyle %}

<div class="invite-block color-{{ section.settings.color_scheme }} gradient" style="--invite-accent: {{ section.settings.accent_color }};">
  <div class="invite-block__inner">

    {%- if section.settings.tag != blank -%}
      <span class="invite-tag">{{ section.settings.tag | escape }}</span>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="invite-block__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.lead != blank -%}
      <p class="invite-block__lead">{{ section.settings.lead | escape }}</p>
    {%- endif -%}

    {%- assign perk_items = section.blocks | where: 'type', 'perk' -%}
    {%- if perk_items.size > 0 -%}
      <div class="invite-perks">
        {%- for block in section.blocks -%}
          {%- if block.type == 'perk' -%}
            <div class="invite-perk" {{ block.shopify_attributes }}>
              <span class="invite-perk__icon">{{ block.settings.icon | escape }}</span>
              <h3 class="invite-perk__title">{{ block.settings.title | escape }}</h3>
              <p class="invite-perk__text">{{ block.settings.text | escape }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign eligibility_items = section.blocks | where: 'type', 'eligibility' -%}
    {%- if eligibility_items.size > 0 -%}
      <div class="invite-eligibility">
        {%- if section.settings.eligibility_heading != blank -%}
          <p class="invite-eligibility__title">{{ section.settings.eligibility_heading | escape }}</p>
        {%- endif -%}
        <ul class="invite-eligibility__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'eligibility' -%}
              <li class="invite-eligibility__item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link }}" class="invite-cta">{{ section.settings.cta_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.email_label != blank -%}
      <a href="mailto:{{ section.settings.email | escape }}" class="invite-cta invite-cta--ghost">{{ section.settings.email_label | escape }}</a>
    {%- endif -%}

  </div>
</div>


{%- style -%}
  #MomentsHero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% stylesheet %}
  .moments-hero__header {
    text-align: center;
    padding-bottom: 4rem;
  }
  .moments-hero__subtitle {
    margin-top: 1.2rem;
    opacity: 0.7;
    font-size: 1.5rem;
    letter-spacing: 0.05em;
  }
  .moments-hero__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  @media screen and (max-width: 989px) {
    .moments-hero__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 749px) {
    .moments-hero__grid { grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  }
  .moments-hero__card {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #e8e3dc;
    text-decoration: none;
  }
  .moments-hero__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .moments-hero__card:hover .moments-hero__card-img {
    transform: scale(1.05);
  }
  .moments-hero__card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20,18,16,0.65) 0%, transparent 55%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.4rem;
  }
  .moments-hero__card-title {
    color: #fff;
    font-size: 1.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
    line-height: 1.2;
  }
  .moments-hero__card-cta {
    color: rgba(255,255,255,0.8);
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255,255,255,0.4);
    padding-bottom: 2px;
    display: inline-block;
    transition: color 0.2s, border-color 0.2s;
  }
  .moments-hero__card:hover .moments-hero__card-cta {
    color: #fff;
    border-color: #fff;
  }
  .moments-hero__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8e3dc;
    color: #b0a898;
    font-size: 1.2rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
{% endstylesheet %}

{%- liquid
  assign moments_links = nil
  for top_link in linklists['main-menu'].links
    if top_link.title == section.settings.menu_item_title
      assign moments_links = top_link.links
      break
    endif
  endfor
-%}

<div
  id="MomentsHero-{{ section.id }}"
  class="moments-hero color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="moments-hero__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="moments-hero__subtitle">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if moments_links -%}
      <div class="moments-hero__grid">
        {%- for link in moments_links -%}
          {%- assign col = link.object -%}
          <a href="{{ link.url }}" class="moments-hero__card">
            {%- if col.featured_image -%}
              {{- col.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'moments-hero__card-img', alt: col.title -}}
            {%- else -%}
              <div class="moments-hero__placeholder">{{ col.title }}</div>
            {%- endif -%}
            <div class="moments-hero__card-overlay">
              <span class="moments-hero__card-title">{{ link.title | escape }}</span>
              <span class="moments-hero__card-cta">{{ section.settings.cta_label | escape }}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Moments hero",
  "tag": "section",
  "class": "moments-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "menu_item_title",
      "label": "Nav item title",
      "default": "Moments",
      "info": "Must match the exact nav item title in your main menu."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Celebrate Every Moment"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "hxl", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Fine gold jewelry crafted for life's most meaningful occasions."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Card CTA label",
      "default": "Shop Now"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Moments hero"
    }
  ]
}
{% endschema %}
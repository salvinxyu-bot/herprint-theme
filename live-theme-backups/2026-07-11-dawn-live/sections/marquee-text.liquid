{%- style -%}
  #MarqueeText-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #MarqueeText-{{ section.id }} .marquee-text__track {
    animation-duration: {{ section.settings.speed }}s;
  }
{%- endstyle -%}

{% stylesheet %}
  .marquee-text-section {
    overflow-x: clip;
  }
  .marquee-text__track {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    animation: marquee-text 20s linear infinite;
    will-change: transform;
  }
  .marquee-text__track:hover {
    animation-play-state: paused;
  }
  @keyframes marquee-text {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .marquee-text__item {
    font-size: 1.2rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0 2.4rem;
  }
  .marquee-text__sep {
    opacity: 0.4;
    font-size: 0.65em;
    flex-shrink: 0;
  }
{% endstylesheet %}

<div
  id="MarqueeText-{{ section.id }}"
  class="marquee-text-section color-{{ section.settings.color_scheme }} gradient"
>
  <div class="marquee-text__track">
    {%- for i in (1..8) -%}
      <span class="marquee-text__item">{{ section.settings.text | escape }}</span>
      <span class="marquee-text__sep" aria-hidden="true">{{ section.settings.separator | escape }}</span>
    {%- endfor -%}
    {%- for i in (1..8) -%}
      <span class="marquee-text__item" aria-hidden="true">{{ section.settings.text | escape }}</span>
      <span class="marquee-text__sep" aria-hidden="true">{{ section.settings.separator | escape }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee text",
  "tag": "section",
  "class": "marquee-text-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Handcrafted in Gold · Free Shipping · Free Returns · Made to Last"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "✦"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Speed",
      "default": 20
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Marquee text"
    }
  ]
}
{% endschema %}
</main>
</div>
<script>(function(){
document.querySelectorAll('#metal .mf-pill').forEach(function(p){
    p.addEventListener('click',function(){
      document.querySelectorAll('#metal .mf-pill').forEach(function(x){x.classList.remove('on');});
      p.classList.add('on');
    });
  });
  document.querySelectorAll('#social .mf-pill').forEach(function(p){
    p.addEventListener('click',function(){p.classList.toggle('on');});
  });
  document.getElementById('send').addEventListener('click',function(){
    document.getElementById('formInner').style.display='none';
    document.getElementById('thanks').classList.add('show');
    document.getElementById('thanks').scrollIntoView({behavior:'smooth',block:'center'});
  });
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});
  },{threshold:.12});
  document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});

  // side-nav scroll-spy
  (function(){
    var links=Array.prototype.slice.call(document.querySelectorAll('.sidenav a'));
    if(!links.length)return;
    var map={};links.forEach(function(l){map[l.getAttribute('data-sec')]=l;});
    var secs=links.map(function(l){return document.getElementById(l.getAttribute('data-sec'));}).filter(Boolean);
    if(links[0])links[0].classList.add('active');
    var spy=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting&&map[e.target.id]){
          links.forEach(function(l){l.classList.remove('active');});
          map[e.target.id].classList.add('active');
        }
      });
    },{rootMargin:'-45% 0px -50% 0px',threshold:0});
    secs.forEach(function(s){spy.observe(s);});
  })();
})();</script>
<script>(function(){
  var top=document.querySelector('#muse .mtop'); if(!top)return;
  var fill=top.querySelector('.mtop__fill'),num=top.querySelector('.mtop__num'),lab=top.querySelector('.mtop__label');
  var links=Array.prototype.slice.call(document.querySelectorAll('#muse .sidenav a'));
  var secs=links.map(function(l){return document.getElementById(l.getAttribute('data-sec'));});
  function update(){
    var st=window.pageYOffset||document.documentElement.scrollTop;
    var h=document.documentElement.scrollHeight-window.innerHeight;
    fill.style.width=(h>0?Math.min(100,Math.max(0,st/h*100)):0)+'%';
    var idx=0;
    for(var i=0;i<secs.length;i++){if(secs[i]&&secs[i].getBoundingClientRect().top<=120)idx=i;}
    var l=links[idx];if(l){var n=l.querySelector('.n'),lb=l.querySelector('.label');if(n)num.textContent=n.textContent;if(lb)lab.textContent=lb.textContent;}
  }
  update();
  window.addEventListener('scroll',update,{passive:true});
  window.addEventListener('resize',update);
})();</script>

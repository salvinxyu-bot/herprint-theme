    { "type": "range", "id": "button_spacing", "label": "Button letter spacing", "min": 0, "max": 0.5, "step": 0.1, "unit": "em", "default": 0.2 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_paper", "label": "Background", "default": "#fafaf7" },
    { "type": "color", "id": "color_ink", "label": "Headings & main text", "default": "#2a2a2a" },
    { "type": "color", "id": "color_ink_soft", "label": "Muted / secondary text", "default": "#6f6160" },

    { "type": "inline_richtext", "id": "hero_title", "label": "Heading", "default": "We'd love to mark your next <em>becoming.</em>" },
    { "type": "textarea", "id": "hero_lede", "label": "Intro text", "default": "A little gift, a lot of heart. Wear it on whatever feels most you — and if it makes you smile, share it with your people." },
    { "type": "text", "id": "hero_btn1_label", "label": "Button 1 label", "default": "Count me in" },
    { "type": "text", "id": "hero_btn1_link", "label": "Button 1 link", "default": "#apply" },
    { "type": "text", "id": "hero_btn2_label", "label": "Button 2 label", "default": "Read our note" },
